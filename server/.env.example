# ─────────────────────────────────────────────────
# Supply Chain Routing Engine — Server Environment
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.

# Server port (default: 3000)
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/supply_chain_db

# Redis connection string (used by Member 2 for distributed locking)
REDIS_URL=redis://localhost:6379

# Google Maps Distance Matrix API key (Member 2 — optional, falls back to haversine)
GOOGLE_MAPS_API_KEY=

# Google Gemini API key (Member 2 — async AI explainability, free tier via Google AI Studio)
GEMINI_API_KEY=

# ─── Rate Limiting (Week 4) ──────────────────────
# Sliding window duration for checkout rate limiter (milliseconds, default: 60000)
RATE_LIMIT_WINDOW_MS=60000
# Max checkout requests per IP per window (default: 30)
RATE_LIMIT_MAX=30

# ─── Gemini Circuit Breaker (Week 4) ─────────────
# Consecutive failures before tripping circuit to OPEN (default: 5)
GEMINI_FAILURE_THRESHOLD=5
# Time in ms to keep circuit OPEN before testing HALF_OPEN (default: 60000)
GEMINI_COOLDOWN_MS=60000
